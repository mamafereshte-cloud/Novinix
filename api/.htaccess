# ============================================
# تنظیمات امنیتی API - Laragon
# ============================================

# اجازه دسترسی به همه فایل‌های PHP در این پوشه
<FilesMatch "\.(php)$">
    Order Allow,Deny
    Allow from all
    Require all granted
</FilesMatch>

# جلوگیری از مشاهده فایل‌ها
Options -Indexes

# هدرهای امنیتی
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Username"
</IfModule>